// CitadelPQVPN — polkit-правило: управление туннелем без пароля для членов группы citadel-vpn.
//
// Зачем. GUI поднимает туннель через `pkexec citadel-helper`, и по умолчанию (.policy,
// auth_admin_keep) polkit просит пароль администратора. Диалог всплывает не только на первое
// подключение: КАЖДЫЙ реконнект (смена WiFi/LTE, восстановление связи) — это новый запуск
// хелпера, то есть новый запрос. Для VPN-клиента, который обязан переподключаться сам, это
// нерабочий сценарий: пользователь либо сидит и вводит пароль, либо остаётся без туннеля.
//
// Модель авторизации после установки этого файла ровно та же, что у консольного клиента:
// **право управлять VPN даёт членство в группе `citadel-vpn`** (там оно проверяется правами на
// управляющий сокет /run/citadel-vpn/ctl, здесь — этим правилом). Кто не в группе — как раньше,
// через пароль администратора.
//
// Что это даёт члену группы: запуск /usr/lib/citadel-pqvpn/citadel-helper от root, то есть
// управление TUN-интерфейсом, маршрутами, правилами firewall и резолвером системы. Хелпер
// валидирует свои аргументы на границе привилегий (адреса/CIDR/MTU — типизированный разбор,
// «в обход» не шире /8), но сам факт остаётся: на многопользовательской машине в группу
// `citadel-vpn` стоит добавлять только тех, кому вы доверяете системную сеть. Именно поэтому
// установщик никого в группу не добавляет сам.
//
// Ставится в /etc/polkit-1/rules.d/ (нужен polkit ≥ 0.106 с поддержкой JS-правил).

polkit.addRule(function (action, subject) {
    if (action.id !== "dev.citadelpqvpn.helper") {
        return polkit.Result.NOT_HANDLED;
    }
    // Только локальная активная сессия: по SSH/из неактивной сессии пароль по-прежнему спросят
    // (там подтверждать нажатием у машины некому).
    if (subject.local && subject.active && subject.isInGroup("citadel-vpn")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED; // остальным — правила из .policy (auth_admin)
});
