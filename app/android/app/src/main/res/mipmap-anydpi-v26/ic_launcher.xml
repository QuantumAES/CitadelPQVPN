<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-иконка (Android 8+/API26). Без неё система применяет к легаси-PNG «legacy treatment»:
  ужимает картинку и подкладывает БЕЛЫЙ круг — то самое «мелкая квадратная иконка в белом круге»
  на Android 13.

  Слои — 108dp; маска ОС вырезает из них центральные 72dp, причём ФОРМОЙ: у круглого лаунчера
  это круг Ø72dp, вписанный в квадрат, — его углы обрезаются. Поэтому арт в
  ic_launcher_foreground.png вписан ДИАГОНАЛЬЮ в safe-круг Ø66dp: картинка видна ЦЕЛИКОМ при
  любой форме маски (круг, squircle, капля), с запасом до кромки. Генерирует —
  tools/sync-app-icons.py, руками файл не правим.

  Фон — цвет рамки самого арта (#002729), чтобы кромка маски сливалась с ним, а не светилась белым.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
